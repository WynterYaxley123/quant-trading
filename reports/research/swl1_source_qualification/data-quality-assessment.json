  "findings": [
    {
      "finding_id": "CORPORATE_ACTION_LINEAGE",
      "finding": "TDX xdxr is the actual corporate_actions adapter (schema 2); Sina supplies adjustment factors. This new inventory clarifies the earlier aggregate label without changing PR34 reports.",
      "verification": "PINNED_SOURCE_CODE_VERIFIED"
    },
    {
      "finding_id": "ADJUSTMENT_FORMULA",
      "finding": "Reader adjusted prices multiply raw prices by stored hfq factors; qfq divides by a scoped latest hfq anchor. BaoStock fallback divides adjusted/raw closes and rescales its newest shared session. Source code formulas are verified, exact historical values and PIT are not.",
      "verification": "SOURCE_FORMULA_VERIFIED_NUMERIC_QA_NOT_RUN"
    },
    {
      "finding_id": "METHOD_DIRECTION_AMBIGUITY",
      "finding": "BaoStock PDF and factor-field document express opposing ratios for forward/backward factor names. Provider must clarify definitions and equivalence before cross-provider QA is certified.",
      "verification": "OFFICIAL_DOCUMENT_AMBIGUITY_REQUIRES_PROVIDER_CONFIRMATION"
    },
    {
      "finding_id": "SUSPENSION_AND_REVISION",
      "finding": "BaoStock specifies flat-price/zero-volume suspension rows and publishes later corrections. Current returned history is not original contemporaneous data.",
      "verification": "DOCUMENTED_METHOD_ONLY"
    },
    {
      "finding_id": "DELISTING_SAMPLE_NOT_COMPLETENESS",
      "finding": "SSE example distinguishes announcement, end of delisting period and removal. No complete SH/SZ/BJ universe was reconciled.",
      "verification": "ONE_PUBLIC_EVENT_ONLY"
    },
    {
      "finding_id": "DERIVED_NOT_OFFICIAL",
      "finding": "CNEquity industry_index is derived from members and adjusted stocks and excludes rows without exact adjustments; project SWL1 uses explicit hierarchy mapping. Neither becomes an official index through code naming.",
      "verification": "SOURCE_CODE_ONLY"
    },
    {
      "finding_id": "UPSTREAM_COMMENT_NOT_PIT_PROOF",
      "finding": "Comments claiming historical known membership or provider independence do not establish actual publication receipts or independent upstream origin.",
      "verification": "SOURCE_COMMENT_NOT_EVIDENCE"
    }
  ],
  "stage_a": "COMPLETE_METADATA_ONLY",
  "stage_b": "BLOCKED_RIGHTS_AND_ACCESS_NOT_ESTABLISHED"
}
