# .gitignore — quant-trading

# 数据与日志（永不进 Git）
data/
logs/
secrets/

# 环境变量
.env
.env.*
!.env.example

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境（本项目不使用，防御性忽略）
.venv/
venv/
ENV/
env/

# 测试与检查缓存
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints/

# 日志
*.log

# 编辑器与系统
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Docker
docker/*.log
