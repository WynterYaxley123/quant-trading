# .gitignore — quant-trading

# 数据与日志（永不进 Git）
# 注意：必须用前导斜杠限定为**项目根目录**下的同名目录。
# 否则 `data/` 会匹配任意层级的 data 目录，误伤源码（src/data/）、
# 脚本（scripts/data/）与文档（docs/data/）—— 本项目已实际踩过此坑。
/data/
/logs/
/secrets/

# Prevent accidental vendoring of external ETF runtime, sidecar and market data.
/runtime/
/external/
/lake/
/exports/
/cache/
**/.cnequity/
**/cnequity_cache/
services/etf-quant*/state/
services/etf-quant*/runtime/
services/cnequity-sidecar/lake/
services/cnequity-sidecar/exports/
services/cnequity-sidecar/logs/
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.db-wal
*.db-shm
*.h5
*.hdf5
*.parquet
*.p12
*.pfx
id_rsa*
node_modules/

# 回测产物（每次运行生成，体积大且不可复现，不进 Git）
/reports/backtests/
# 非执行研究运行产物（可由冻结输入重新生成）
/reports/research/

# 环境变量
.env
.env.*
!.env.example

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境（本项目不使用，防御性忽略）
.venv/
venv/
ENV/
env/

# 测试与检查缓存
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints/

# 日志
*.log

# 编辑器与系统
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Docker
docker/*.log
