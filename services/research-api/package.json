{
  "name": "@quant-trading/research-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit.test.ts tests/approval.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "csv-parse": "6.1.0",
    "hono": "4.13.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@11.25.0"
}
