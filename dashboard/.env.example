# Shenwan Research Dashboard — environment variables
# 复制为 .env.local 后按需修改。本项目第一版不需要任何 secrets。

# 数据模式：
#   api  = 连接 READ-ONLY Research Data API（默认；API 不可用时显示 "API disconnected"，不会静默回退）
#   mock = 使用内置合成测试数据（synthetic，仅开发用；UI 会显示 MOCK DATA 标记）
VITE_DATA_MODE=api

# Research Data API base URL（仅 VITE_DATA_MODE=api 时使用）
VITE_RESEARCH_API_BASE_URL=http://127.0.0.1:8787/api/v1
