# ==========================================================
# quant-trading - Environment Variable Template
# ==========================================================
# Usage:
#   1. Copy this file to .env   ->   cp .env.example .env
#   2. Fill real values into .env
#   3. .env is ignored by .gitignore, never enters Git
#
# WARNING: This file is a TEMPLATE ONLY.
#          Never put real accounts / passwords / tokens here.
#          This file IS committed to Git.
#
# 当前阶段（Environment Setup）：
#   所有凭证项必须保持为空。不接入券商，不配置真实账号。
# ==========================================================


# ----------------------------------------------------------
# Broker account (leave EMPTY at this stage)
# ----------------------------------------------------------
BROKER_ACCOUNT=
BROKER_PASSWORD=


# ----------------------------------------------------------
# Generic API token (leave EMPTY at this stage)
# ----------------------------------------------------------
API_TOKEN=


# ----------------------------------------------------------
# Juejin / MyQuant (fill later when integrating)
# Apply at: https://www.myquant.cn/
# ----------------------------------------------------------
MYQUANT_TOKEN=


# ----------------------------------------------------------
# Data sources (optional, public sources only)
# ----------------------------------------------------------
TUSHARE_TOKEN=


# ----------------------------------------------------------
# Runtime
# ----------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai


# ----------------------------------------------------------
# Safety master switch: MUST stay true at this stage.
# Live trading is forbidden until explicitly approved.
# ----------------------------------------------------------
DISABLE_LIVE_TRADING=true


# ----------------------------------------------------------
# JupyterLab (local access only, bound to 127.0.0.1)
# Access: http://localhost:8888/lab (token authentication).
# REQUIRED before Compose validation/start: set a nonempty private token in .env.
# Empty deliberately fails closed. Never commit the configured .env.
# ----------------------------------------------------------
JUPYTER_TOKEN=
JUPYTER_PORT=8888


# ----------------------------------------------------------
# Feishu notification (future)
# Current stage: skeleton only, no real notification is sent.
# Leave ALL values EMPTY in this template.
# Real values only in .env (gitignored). Never commit.
# ----------------------------------------------------------
FEISHU_WEBHOOK=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
